# ---- 基础 ----
MP_APP_NAME=MusicPilot Scraper
MP_LOG_LEVEL=INFO
# 登录认证始终开启：全新数据库首次访问会要求创建管理员账号（PBKDF2 加盐存 SQLite）。
# 下面两项仅用于把旧部署或无人值守安装引导成第一个账号；全新部署留空，在网页上注册即可。
MP_ADMIN_USERNAME=admin
MP_ADMIN_PASSWORD=
# 留空时自动生成并保存在数据目录，重启后保持有效。
MP_SESSION_SECRET=

# ---- 目录（容器内路径，见 README 的挂载说明）----
MP_SOURCE_DIR=/media/downloads
MP_LIBRARY_DIR=/media/music
MP_DATA_DIR=/data
# 目录选择器允许浏览的容器内根目录（逗号分隔）；当前源/库目录的父目录会自动加入
MP_BROWSABLE_ROOTS=/media

# ---- 刮削 ----
# copy | move | hardlink | symlink
MP_TRANSFER_MODE=copy
MP_NAMING_TEMPLATE={artist}/{album}/{track:02d} - {title}
MP_CONFLICT_POLICY=rename
MP_SYMLINK_RELATIVE=true
MP_WRITE_TAGS=true
MP_EMBED_COVER=true
MP_WRITE_LYRICS=false
# 逗号分隔：local,musicbrainz,netease
MP_METADATA_SOURCES=local,musicbrainz,netease
MP_CONFIDENCE_THRESHOLD=0.62
MP_UNKNOWN_PLACEHOLDER=Unknown
MP_MUSICBRAINZ_USER_AGENT=MusicPilot-Scraper/2.0 (self-hosted personal use)

# ---- 网络 ----
# 如需代理访问 MusicBrainz / 网易云，填写例如 http://127.0.0.1:7897
MP_HTTP_PROXY=
MP_REQUEST_TIMEOUT=20

# ---- 扫描 ----
MP_SCAN_EXTENSIONS=.mp3,.flac,.wav,.m4a,.aac,.ogg,.opus,.aiff,.aif,.dsf,.dff,.wma,.ape
MP_EXCLUDE_DIRS=@eaDir,.git,.thumbnails,System Volume Information
MP_MAX_SCAN_FILES=5000
